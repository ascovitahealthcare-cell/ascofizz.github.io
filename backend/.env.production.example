# ═══════════════════════════════════════════════════════════════════════
# ASCOFIZZ BACKEND — ENVIRONMENT TEMPLATE
#
# Copy to .env and fill in. NEVER commit a filled-in copy: .gitignore
# already excludes .env, and every value below marked (secret) is one that
# grants access to money, customer data or the database.
#
# This deployment must NOT reuse any credential from the platform it was
# forked from. Create a new Supabase project, new gateway keys and new
# webhook secrets. Nothing here has a working default on purpose.
# ═══════════════════════════════════════════════════════════════════════

# ── Runtime ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Brand identity ─────────────────────────────────────────────────────
# Everything brand-facing (e-mail, invoices, CORS, admin gate) reads these
# through backend/brand.config.js.
BRAND_NAME=Ascofizz
BRAND_NAME_UPPER=ASCOFIZZ
BRAND_LEGAL_NAME=Ascofizz Healthcare
# One line describing the company, used to ground the AI assistant prompts.
BRAND_DESCRIPTOR=an Indian nutraceutical brand

# ── Public URLs ────────────────────────────────────────────────────────
# FRONTEND_URL  the storefront origin customers use.
# SERVICE_URL   this API's own public origin. Webhook notify_url values and
#               the self-check are built from it, so it must be reachable
#               from the payment/shipping providers.
# ADMIN_URL     where admin.html is served. Defaults to FRONTEND_URL.
FRONTEND_URL=https://ascofizz.com
SERVICE_URL=https://api.ascofizz.com
ADMIN_URL=https://ascofizz.com
# Extra origins allowed through CORS / the admin origin gate (comma separated).
CORS_EXTRA_ORIGINS=
ADMIN_EXTRA_ORIGINS=
# Extra first-party hostnames that must not count as referral traffic.
SELF_HOSTS=

# ── Brand assets ───────────────────────────────────────────────────────
# Absolute URLs: they are embedded in e-mail and PDFs, read outside the site.
BRAND_ASSET_BASE=
BRAND_LOGO_URL=
BRAND_LOGO_LIGHT_URL=

# ── Contact ────────────────────────────────────────────────────────────
SUPPORT_EMAIL=support@ascofizz.com
SUPPORT_PHONE=
COMPANY_ADDRESS=

# ── Commerce ───────────────────────────────────────────────────────────
CURRENCY=INR
CURRENCY_SYMBOL=₹
COUNTRY=India

# ── Supabase (secret) ──────────────────────────────────────────────────
# A NEW project. SUPABASE_SERVICE_KEY bypasses row-level security — it is
# the most dangerous value in this file and must never reach the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Auth (secret) ──────────────────────────────────────────────────────
# JWT_SECRET: generate with `openssl rand -base64 48`. Rotating it logs
# everyone out; JWT_SECRET_FALLBACK lets old tokens verify during a
# rotation window and should be cleared afterwards.
JWT_SECRET=
JWT_SECRET_FALLBACK=
ADMIN_PASSWORD=
OWNER_PASSWORD=
SAVE_PASSWORD=
ADMIN_SESSION_HOURS=12
# Identity stamped on the JWT when the env-password login path is used.
OWNER_IDENTITY_EMAIL=
ADMIN_IDENTITY_EMAIL=
# Guards server-to-server calls.
INTERNAL_API_KEY=

# ── Google sign-in ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments — Cashfree (secret) ───────────────────────────────────────
# CASHFREE_ENV: SANDBOX or PRODUCTION. The webhook signature is HMAC-SHA256
# over (timestamp + raw body) keyed with CASHFREE_SECRET_KEY, so that value
# is also the webhook secret.
CASHFREE_ENV=PRODUCTION
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01

# ── Payments — GoKwik (secret) ─────────────────────────────────────────
GOKWIK_ENV=production
GOKWIK_APP_ID=
GOKWIK_APP_SECRET=

# ── Shipping — Delhivery (secret) ──────────────────────────────────────
DELHIVERY_ENV=production
DELHIVERY_API_TOKEN=
DELHIVERY_BASE_URL=
DELHIVERY_CLIENT_NAME=
DELHIVERY_USER_NAME=
DELHIVERY_WEBHOOK_SECRET=
DELHIVERY_PICKUP_LOCATION=
DELHIVERY_PICKUP_ADDRESS=
DELHIVERY_PICKUP_CITY=
DELHIVERY_PICKUP_STATE=
DELHIVERY_PICKUP_PIN=
DELHIVERY_PICKUP_PHONE=
DELHIVERY_HSN_CODE=30049099

# ── Shipping — Shiprocket (secret) ─────────────────────────────────────
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ── Statutory invoice details ──────────────────────────────────────────
# Printed on every GST tax invoice. These are a legal declaration: a wrong
# GSTIN on an issued invoice is a compliance problem, and leaving them
# blank issues non-compliant documents. Fill them before taking orders.
SELLER_LEGAL_NAME=Ascofizz Healthcare
SELLER_GST_TIN=
SELLER_FSSAI=
SELLER_ADDR1=
SELLER_ADDR2=
SELLER_STATE=
SELLER_STATE_CODE=
SELLER_HSN_DEFAULT=2106
SELLER_GST_RATE=5

# ── E-mail (secret) ────────────────────────────────────────────────────
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Ascofizz <no-reply@ascofizz.com>

# ── WhatsApp / SMS (secret) ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_REPORT_TO=
WHATSAPP_CALLMEBOT_KEYS=

# ── AI assistants (secret, optional) ───────────────────────────────────
AI_PRIMARY_PROVIDER=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Analytics ──────────────────────────────────────────────────────────
# Salt for hashing visitor IPs. Raw IPs are never stored; changing this
# breaks continuity of existing sessions.
ANALYTICS_IP_SALT=
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
INSTAGRAM_TOKEN=

# ── Promotions ─────────────────────────────────────────────────────────
# Mix & Match: every Nth eligible unit is free. Must match the storefront's
# copy of the same rule or checkout shows one total and charges another.
MIX_MATCH_ENABLED=true
MIX_MATCH_ELIGIBLE_IDS=
MIX_MATCH_MAX_GROUPS=0

# ── Order limits ───────────────────────────────────────────────────────
MAX_COD_ORDER_VALUE=
MAX_QTY_PER_LINE=10
LARGE_ORDER_ALERT=

# ── Background jobs ────────────────────────────────────────────────────
AUTO_SHIP=false
AUTO_PICKUP=false
AUTO_CYCLE_MS=
AUTO_SHIP_MS=
RECON_INTERVAL_MS=
KEEP_ALIVE=false
